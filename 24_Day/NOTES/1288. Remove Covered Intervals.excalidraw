    {
      "id": "g9lBFFmcU9XmiofuWG1gi",
      "type": "text",
      "x": 162.17751724035702,
      "y": 2182.906577615315,
      "width": 897.9071567330999,
      "height": 1557.0934223846846,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "4z6SpFA1FRmnT5Ggu3499",
      "index": "a1V",
      "roundness": null,
      "seed": 1858289857,
      "version": 35,
      "versionNonce": 1021564769,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1766053599595,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public int removeCoveredIntervals(int[][] intervals) {\n        // count\n        // i = 0... end\n        //    j = 0 ... end\n        //       j interval can cover i interval or not\n        // \n        int count = 0;\n        // T: O(n^2), S: O(1)\n        // [[1,4],[3,6],[2,8]]\n        //.                i\n        //.                    j\n        // count = 2\n        // c = 3, d = 6\n        // a = 2, b = 8\n        for (int i = 0; i < intervals.length; i = i + 1) {\n            int c = intervals[i][0],\n                d = intervals[i][1];\n\n            boolean isCovered = false;\n            for (int j = 0; j < intervals.length; j = j + 1) {\n                // i interval -> koi i ko kha sakta hai ya nahi\n                int a = intervals[j][0],\n                    b = intervals[j][1];\n\n                if (i != j && (a <= c && b >= d)) {\n                    isCovered = true;\n                    break;\n                }\n            }\n\n            if (!isCovered) {\n                count = count + 1;\n            }\n        }\n\n        return count;\n    }\n}",
      "fontSize": 31.94037789507046,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public int removeCoveredIntervals(int[][] intervals) {\n        // count\n        // i = 0... end\n        //    j = 0 ... end\n        //       j interval can cover i interval or not\n        // \n        int count = 0;\n        // T: O(n^2), S: O(1)\n        // [[1,4],[3,6],[2,8]]\n        //.                i\n        //.                    j\n        // count = 2\n        // c = 3, d = 6\n        // a = 2, b = 8\n        for (int i = 0; i < intervals.length; i = i + 1) {\n            int c = intervals[i][0],\n                d = intervals[i][1];\n\n            boolean isCovered = false;\n            for (int j = 0; j < intervals.length; j = j + 1) {\n                // i interval -> koi i ko kha sakta hai ya nahi\n                int a = intervals[j][0],\n                    b = intervals[j][1];\n\n                if (i != j && (a <= c && b >= d)) {\n                    isCovered = true;\n                    break;\n                }\n            }\n\n            if (!isCovered) {\n                count = count + 1;\n            }\n        }\n\n        return count;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
