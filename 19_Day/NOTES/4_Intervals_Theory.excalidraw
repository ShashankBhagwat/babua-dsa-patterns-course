      "isDeleted": true,
      "boundElements": [],
      "updated": 1765176166883,
      "link": null,
      "locked": false,
      "text": "sliding_window_dynamic(arr, condition):\n    left = 0   \n    result = window\n\n    for i in range(k, len(arr)):\n        window = add arr[i] to window\n        window = subtract arr[i - k] from window\n        \n        result = best(result, window)\n\n    return result\n    ",
      "fontSize": 38.666666666666664,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sliding_window_dynamic(arr, condition):\n    left = 0   \n    result = window\n\n    for i in range(k, len(arr)):\n        window = add arr[i] to window\n        window = subtract arr[i - k] from window\n        \n        result = best(result, window)\n\n    return result\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
