      "updated": 1765176166884,
      "link": null,
      "locked": false,
      "text": "sliding_window_dynamic(arr, condition):\n    left = 0 \n    \n    result = ???\n\n    for right in range(len(arr)):\n        # expand window\n        \n        while condition violated:\n            shrink window\n        \n        result = process result between left and right\n    \n    return result\n    ",
      "fontSize": 38.666666666666664,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sliding_window_dynamic(arr, condition):\n    left = 0 \n    \n    result = ???\n\n    for right in range(len(arr)):\n        # expand window\n        \n        while condition violated:\n            shrink window\n        \n        result = process result between left and right\n    \n    return result\n    ",
      "autoResize": true,
      "lineHeight": 1.25
